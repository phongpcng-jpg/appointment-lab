{
  "name": "appointment-lab",
  "private": true,
  "workspaces": ["apps/api", "apps/web"],
  "scripts": {
    "dev": "concurrently \"npm --workspace apps/api run dev\" \"npm --workspace apps/web run dev\"",
    "test": "npm run test --workspaces",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "format:check": "prettier --check .",
    "db:migrate": "npm --workspace apps/api run db:migrate",
    "db:rollback": "npm --workspace apps/api run db:rollback"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.34.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2"
  }
}
