# Backend runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/appointment_lab

# Frontend/API access
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ADMIN bootstrap
ADMIN_EMAIL=admin@example.com

# Access-token configuration
# Use a cryptographically random secret of at least 32 characters in real environments.
JWT_ACCESS_SECRET=replace-me-with-a-long-random-secret
JWT_ACCESS_TTL=15m

# Generic SMTP
# Required by the application when email delivery is enabled.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=no-reply@example.com

# PostgreSQL integration tests
# Keep disabled for normal `npm test`; enable explicitly when testing against a local DB.
# RUN_DB_INTEGRATION=1
